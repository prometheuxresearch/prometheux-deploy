# Databricks Configuration Variables
# Copy this file to terraform.tfvars and fill in your actual values

# Databricks workspace URL (e.g., https://your-workspace.cloud.databricks.com)
databricks_host = "https://your-workspace.cloud.databricks.com"

# Databricks personal access token
# Generate this from: Databricks workspace > User Settings > Access Tokens
databricks_token = "your-databricks-token-here"

# Cluster configuration
cluster_name = "prometheux-spark-connect"
spark_version = "17.1.x-scala2.13"  # Spark 4.0 with Java 17 support

# Authentication configuration
# Options: "pat" (Personal Access Token) or "oauth" (OAuth with Service Principal)
authentication_mode = "pat"

# Service Principal ID (required only if authentication_mode = "oauth")
# Get this from Databricks Account Console → User Management → Service Principals
# service_principal_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Node configuration for AWS
node_type_id = "i3.xlarge"         # 4 cores, 30.5 GB RAM, 950 GB SSD
driver_node_type_id = "i3.xlarge"  # Same as worker nodes

# Cluster scaling
min_workers = 1
max_workers = 3 
