# JWT secret key used by the router to validate tokens issued by the Prometheux UI.
# This value is provided by Prometheux.
SECRET_KEY=your-secret-key-here

# Seals the MCP OAuth session tokens used by the Claude connector.
# Must be a stable, random secret (rotating it forces all users to reconnect).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=your-stable-random-secret

# This router's public HTTPS URL, advertised in OAuth discovery metadata.
# Must be the address Claude can reach, e.g. https://px-deploy-test.onpx.ai
OAUTH_ISSUER=https://your-router-domain
