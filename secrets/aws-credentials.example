# AWS credentials for the usage-manager metrics push.
#
# Copy this file to `aws-credentials` (no extension) in the SAME folder and fill
# in the key provided by Prometheux. The real file is git-ignored and is mounted
# into the usage-manager container as a Docker secret — it never appears in the
# compose file, in `.env`, or in `docker inspect`.
#
#   cp secrets/aws-credentials.example secrets/aws-credentials
#   # then edit secrets/aws-credentials
#
# Standard AWS credentials INI format; keep the [default] profile name.
[default]
aws_access_key_id = your-access-key-id
aws_secret_access_key = your-secret-access-key
