# Username of the tenant (used in container names, network name, and passed to the app)
USERNAME=alice

# Organisation name of the tenant (passed to the app)
ORGANIZATION=acme

# Customer name, used in the vadalog-parallel image tag:
#   prometheux-reasoner-premises-${CUSTOMER}:latest
# This value is provided by Prometheux.
CUSTOMER=acme

# Port on which jarvispy is exposed on the host.
# Must match the routing entry in router/config.yaml for this user.
JARVISPY_PORT=8001

# Port on which JupyterLab is exposed on the host.
JUPYTERLAB_PORT=8888

# Access token for JupyterLab. Choose any value — this is the token you will use to log in.
JUPYTERLAB_TOKEN=your-jupyterlab-token-here

# ── Usage metering (usage-manager) ────────────────────────────────────────────
# The usage-manager container pushes this tenant's usage to Prometheux's S3
# bucket, under users/${ORGANIZATION}/${USERNAME}/ (ORGANIZATION is set above).
#
# The AWS credentials are NOT set here — they are provided as a Docker secret so
# the key never lands in this file or in `docker inspect`. Create it once per
# tenant folder from the template:
#   cp secrets/aws-credentials.example secrets/aws-credentials
#   # edit secrets/aws-credentials with the key provided by Prometheux
# The same key is used for every tenant on this machine.

# Optional: seconds between pushes (default 300).
# USAGE_S3_SYNC_INTERVAL=300
